---
// The timeline of the research project (chapter 1 of the thesis), under the
// drawing of the threads. Its black lines turn red behind a small red dot that
// runs along each of them, all at the same year: the lineages advance together
// and converge towards the cloud. The year runs in step with the threads above,
// and the reader can take it in hand (src/scripts/history.ts).
import { projects } from '../data/projects';
import { href } from '../lib/url';
import { langOf, ui } from '../i18n';
const lang = langOf(Astro.url.pathname);
const t = ui[lang].swirl;
const fig = projects.find((p) => p.theme === 'history' && p.figure)?.figure;
const src = fig && (typeof fig.src === 'string' ? fig.src : fig.src[lang]);
// The timeline's own scale, in the units of its drawing: x of 1800 and units per year.
const X1800 = 112, PER_YEAR = 2.405, AXIS = 359;
---
{fig && src && (
  <figure class="project-figure frise" data-x1800={X1800} data-per-year={PER_YEAR}>
    <div class="frise-scroll">
      <div class="frise-wrap">
        <img src={href(src)} alt={fig.alt[lang]} loading="lazy" />
        <svg class="frise-now" viewBox="0 0 781.746 433.283" aria-hidden="true">
          {/* Filled by the script: a red copy of the timeline's lines, uncovered up to the present
              year, and a small red dot where each line meets that year. */}
          <defs><clipPath id="fr-clip"><rect class="fr-clip-rect" x="0" y="0" width="0" height="433.283" /></clipPath></defs>
          <g class="fr-red" clip-path="url(#fr-clip)"></g>
          <g class="fr-dots"></g>
          <g class="fr-now" opacity="0">
            <circle class="fr-dot" cx="0" cy={AXIS} r="2.2" />
            <text class="fr-year" x="4" y={AXIS - 5}>1790</text>
          </g>
        </svg>
      </div>
    </div>
    <figcaption>
      <p class="frise-hint">{t.frise}</p>
      {fig.caption && <p>{fig.caption[lang]}</p>}
      <p class="frise-open"><a href={href(src)} target="_blank" rel="noopener">{t.open}</a></p>
    </figcaption>
  </figure>
)}

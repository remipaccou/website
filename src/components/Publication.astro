---
import type { Publication } from '../lib/publications';
import Sigil from './Sigil.astro';
interface Props { item: Publication; sign?: boolean }
const { item, sign = true } = Astro.props;
const theme = sign ? (item.theme as 'history' | 'economics' | 'biophysics' | 'climate' | undefined) : undefined;
---
<li class="pub">
  <span class="pub-year">{item.year}{theme && <Sigil name={theme} class="item-sign" />}</span>
  <div class="pub-body">
    <p class="pub-title">{item.title}</p>
    <p class="pub-meta">
      {item.authors.map((a, i) => (
        <>{a.self ? <span class="pub-self">{a.name}</span> : a.name}{i < item.authors.length - 1 ? (i === item.authors.length - 2 ? ' and ' : ', ') : '.'}</>
      ))}
      {item.venue && <> <cite>{item.venue}</cite>.</>}
      {item.note && <> {item.note}.</>}
    </p>
    {item.link && <p class="pub-link"><a href={item.link} target="_blank" rel="noopener">{item.linkLabel}</a></p>}
  </div>
</li>

---
// The home-page drawing. On the left, the three functions of information
// arrive, each in its own time, and converge into one capital; on the line,
// an open circle: that capital feeds its own growth; on the right, the line
// reaches the heart of three circles, the economy, energy and the climate.
// Ink and one red, drawn as the signs of the site are. Two layouts: wide
// (left to right) and narrow (top to bottom) for phones.
import { langOf, ui } from '../i18n';
const t = ui[langOf(Astro.url.pathname)].convergence;
const words = t.loop.split(' ');
const half = Math.ceil(words.length / 2);
const noteLines = [words.slice(0, half).join(' '), words.slice(half).join(' ')];

// The heart, alive: rings that spread from it (diffusion), thin red roots
// that grow into each of the three circles (complexity), and sparks that
// travel out along the roots, then pass from one circle to the next through
// the zones where they overlap (interaction). Built in units of r, so both
// layouts share it.
const f = (p: { x: number; y: number }) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
function web(V: { x: number; y: number }, r: number) {
  const pt = (deg: number, k: number) => ({ x: V.x + k * r * Math.cos((deg * Math.PI) / 180), y: V.y + k * r * Math.sin((deg * Math.PI) / 180) });
  // Economy (upper left), energy (upper right), climate (below).
  const arms = [{ th: 210, a: -16, b: 24 }, { th: 330, a: -22, b: 18 }, { th: 90, a: -22, b: 22 }];
  const roots: { d: string; i: number; lvl: number }[] = [];
  const tips: { x: number; y: number; deg: number; path: string }[][] = [];
  arms.forEach((A, i) => {
    const S = pt(A.th + 6, 0.58), c = pt(A.th - 8, 0.3);
    const stem = `M${f(V)}Q${f(c)} ${f(S)}`;
    roots.push({ d: stem, i, lvl: 0 });
    tips.push([[A.a, 1.04], [A.b, 1.14]].map(([da, k]) => {
      const T = pt(A.th + da, k), c2 = pt(A.th + da * 0.4, 0.85);
      roots.push({ d: `M${f(S)}Q${f(c2)} ${f(T)}`, i, lvl: 1 });
      return { ...T, deg: A.th + da, path: `${stem}Q${f(c2)} ${f(T)}` };
    }));
  });
  // Each link leaves one circle's root and reaches the next, through their overlap.
  const links = [[0, 1], [1, 2], [2, 0]].map(([i, j]) => {
    const from = tips[i][1], to = tips[j][0];
    let mid = (from.deg + to.deg) / 2;
    if (Math.abs(from.deg - to.deg) > 180) mid += 180;
    return `M${f(from)}Q${f(pt(mid, 1.05))} ${f(to)}`;
  });
  return { roots, tips: tips.flat(), links, R: 1.35 * r };
}

// The flow: six small red dots, one every 1.5 s. Each leaves one of the three
// strands, goes around the open circle, reaches the heart in 5 s whatever its
// strand, then enters one circle along a root in 1.5 s, and starts again 9 s
// later. Strands and circles are crossed, so that each function feeds two
// fields. When a dot reaches a root that touches the next circle, a smaller
// dot carries on along the link, through the zone where the two overlap.
const START = 3.2, GAP = 1.5, T1 = 5, T2 = 1.5, CYCLE = 9;
const dots = [0, 1, 2, 3, 4, 5].map((n) => ({ n, strand: n % 3, tip: (n * 5) % 6 }));
const linkFrom = [1, 3, 5].map((tip) => dots.find((d) => d.tip === tip)!.n);

// Wide layout, viewBox 1160 x 420.
const W = (() => {
  const V = { x: 900, y: 205 }, r = 112, d = 62;
  const eco = { x: V.x - 0.866 * d, y: V.y - 0.5 * d }, ene = { x: V.x + 0.866 * d, y: V.y - 0.5 * d }, cli = { x: V.x, y: V.y + d };
  const C = { x: 500, y: V.y };
  const loop = { x: 630, y: V.y - 38, r: 38 };
  const at = (deg: number) => ({ x: loop.x + loop.r * Math.cos((deg * Math.PI) / 180), y: loop.y + loop.r * Math.sin((deg * Math.PI) / 180) });
  // The open circle of the site's mark, its gap at the upper right.
  const a = at(-60), b = at(-22);
  return {
    box: '0 0 1160 420', V, r, eco, ene, cli, web: web(V, r),
    strands: [
      { d: `M40 95C290 95 400 ${C.y} ${C.x} ${C.y}`, x: 40, y: 95, label: t.transmit },
      { d: `M130 ${C.y}L${C.x} ${C.y}`, x: 130, y: C.y, label: t.compute },
      { d: `M220 315C340 315 400 ${C.y} ${C.x} ${C.y}`, x: 220, y: 315, label: t.store },
    ],
    trunk: `M${C.x} ${C.y}L${V.x} ${V.y}`,
    loop: `M${a.x.toFixed(1)} ${a.y.toFixed(1)}A${loop.r} ${loop.r} 0 1 0 ${b.x.toFixed(1)} ${b.y.toFixed(1)}`,
    tail: `L${loop.x} ${V.y}A${loop.r} ${loop.r} 0 0 0 ${loop.x} ${V.y - 2 * loop.r}A${loop.r} ${loop.r} 0 0 0 ${loop.x} ${V.y}L${V.x} ${V.y}`,
    note: { x: loop.x, y: V.y + 30, anchor: 'middle', split: false },
    labels: [
      { x: eco.x - 0.72 * r, y: eco.y - 0.72 * r, anchor: 'end', text: t.economy },
      { x: ene.x + 0.72 * r, y: ene.y - 0.72 * r, anchor: 'start', text: t.energy },
      { x: cli.x, y: cli.y + r + 26, anchor: 'middle', text: t.climate },
    ],
    labelDy: -13,
  };
})();

// Narrow layout, viewBox 360 x 660.
const N = (() => {
  const V = { x: 180, y: 490 }, r = 86, d = 48;
  const eco = { x: V.x - 0.866 * d, y: V.y - 0.5 * d }, ene = { x: V.x + 0.866 * d, y: V.y - 0.5 * d }, cli = { x: V.x, y: V.y + d };
  const C = { x: V.x, y: 230 };
  const loop = { x: V.x + 34, y: 305, r: 34 };
  const at = (deg: number) => ({ x: loop.x + loop.r * Math.cos((deg * Math.PI) / 180), y: loop.y + loop.r * Math.sin((deg * Math.PI) / 180) });
  const a = at(-60), b = at(-22);
  return {
    box: '0 0 360 660', V, r, eco, ene, cli, web: web(V, r),
    strands: [
      { d: `M60 50C60 160 ${C.x} 170 ${C.x} ${C.y}`, x: 60, y: 50, label: t.transmit },
      { d: `M${C.x} 90L${C.x} ${C.y}`, x: C.x, y: 90, label: t.compute },
      { d: `M300 130C300 195 ${C.x} 195 ${C.x} ${C.y}`, x: 300, y: 130, label: t.store },
    ],
    trunk: `M${C.x} ${C.y}L${V.x} ${V.y}`,
    loop: `M${a.x.toFixed(1)} ${a.y.toFixed(1)}A${loop.r} ${loop.r} 0 1 0 ${b.x.toFixed(1)} ${b.y.toFixed(1)}`,
    tail: `L${V.x} ${loop.y}A${loop.r} ${loop.r} 0 0 0 ${V.x + 2 * loop.r} ${loop.y}A${loop.r} ${loop.r} 0 0 0 ${V.x} ${loop.y}L${V.x} ${V.y}`,
    // On a phone the note goes on two lines, left of the line; the field names sit above their circles.
    note: { x: V.x - 16, y: loop.y - 6, anchor: 'end', split: true },
    labels: [
      { x: eco.x - 24, y: eco.y - r - 12, anchor: 'middle', text: t.economy },
      { x: ene.x + 24, y: ene.y - r - 12, anchor: 'middle', text: t.energy },
      { x: cli.x, y: cli.y + r + 24, anchor: 'middle', text: t.climate },
    ],
    labelDy: -12,
  };
})();
---
<figure class="convergence">
  {[{ L: { ...W, id: 'cvw' }, cls: 'cv-wide' }, { L: { ...N, id: 'cvn' }, cls: 'cv-narrow' }].map(({ L, cls }) => (
    <svg class={cls} viewBox={L.box} role="img" aria-label={t.alt}>
      <g class="cv-circles">
        <circle cx={L.eco.x} cy={L.eco.y} r={L.r} />
        <circle cx={L.ene.x} cy={L.ene.y} r={L.r} />
        <circle cx={L.cli.x} cy={L.cli.y} r={L.r} />
      </g>
      <g class="cv-web" aria-hidden="true">
        <g class="cv-still">{[0.34, 0.62, 0.9].map((k) => <circle class="cv-ring" cx={L.V.x} cy={L.V.y} r={k * L.web.R} />)}</g>
        <g class="cv-waves">{dots.map((p) => (
          <circle class="cv-ring" cx={L.V.x} cy={L.V.y} r="0" opacity="0">
            <animate attributeName="r" values={`3;${L.web.R}`} dur="5s" begin={`${L.id}p${p.n}a.end`} keySplines="0.2 0.6 0.35 1" calcMode="spline" keyTimes="0;1" fill="freeze" />
            <animate attributeName="opacity" values="0.3;0" dur="5s" begin={`${L.id}p${p.n}a.end`} fill="freeze" />
          </circle>
        ))}</g>
        {L.web.links.map((d) => <path class="cv-link" d={d} pathLength="1" />)}
        {L.web.roots.map((p) => <path class={`cv-root l${p.lvl}`} d={p.d} pathLength="1" style={`--i:${p.i}`} />)}
      </g>
      {L.strands.map((s, i) => (
        <g class="cv-strand" style={`--i:${i}`}>
          <path d={s.d} pathLength="1" />
          <circle cx={s.x} cy={s.y} r="3.2" />
          <text x={s.x} y={s.y + L.labelDy} text-anchor={cls === 'cv-narrow' ? 'middle' : 'start'} class="cv-label">{s.label}</text>
        </g>
      ))}
      <path class="cv-trunk" d={L.trunk} pathLength="1" />
      <path class="cv-loop" d={L.loop} pathLength="1" />
      <text class="cv-note" x={L.note.x} y={L.note.y} text-anchor={L.note.anchor}>
        {L.note.split ? noteLines.map((line, i) => <tspan x={L.note.x} dy={i === 0 ? 0 : 20}>{line}</tspan>) : t.loop}
      </text>
      <g class="cv-flow" aria-hidden="true">
        <circle class="cv-beat" cx={L.V.x} cy={L.V.y} r="5" opacity="0">
          <animate attributeName="r" values="5;12" dur="0.8s" begin={dots.map((p) => `${L.id}p${p.n}a.end`).join(';')} fill="freeze" />
          <animate attributeName="opacity" values="0.5;0" dur="0.8s" begin={dots.map((p) => `${L.id}p${p.n}a.end`).join(';')} fill="freeze" />
        </circle>
        {dots.map((p) => (
          <circle class="cv-dot" r="2.6" opacity="0">
            <animateMotion id={`${L.id}p${p.n}a`} path={L.strands[p.strand].d + L.tail} dur={`${T1}s`} begin={`${START + GAP * p.n}s;${L.id}p${p.n}b.end+${CYCLE - T1 - T2}s`} fill="freeze" />
            <animateMotion id={`${L.id}p${p.n}b`} path={L.web.tips[p.tip].path} dur={`${T2}s`} begin={`${L.id}p${p.n}a.end`} fill="freeze" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.3 0.5 0.4 1" />
            <animate attributeName="opacity" values="0;0.95" dur="0.4s" begin={`${L.id}p${p.n}a.begin`} fill="freeze" />
            <animate attributeName="opacity" values="0.95;0.95;0" keyTimes="0;0.7;1" dur={`${T2}s`} begin={`${L.id}p${p.n}b.begin`} fill="freeze" />
          </circle>
        ))}
        {L.web.links.map((d, k) => (
          <circle class="cv-dot" r="1.8" opacity="0">
            <animateMotion path={d} dur="2.2s" begin={`${L.id}p${linkFrom[k]}b.end-0.3s`} fill="freeze" />
            <animate attributeName="opacity" values="0;0.8;0.8;0" keyTimes="0;0.15;0.8;1" dur="2.2s" begin={`${L.id}p${linkFrom[k]}b.end-0.3s`} fill="freeze" />
          </circle>
        ))}
      </g>
      <circle class="cv-heart" cx={L.V.x} cy={L.V.y} r="5" />
      {L.web.tips.map((t, n) => <circle class="cv-node" cx={t.x} cy={t.y} r="2.1" style={`--n:${n}`} />)}
      {L.labels.map((l) => <text class="cv-label cv-field" x={l.x} y={l.y} text-anchor={l.anchor}>{l.text}</text>)}
    </svg>
  ))}
  <button class="cv-toggle" type="button" hidden data-play={t.play} data-pause={t.pause}>{t.pause}</button>
</figure>

<script>
  // The drawing always moves; one click stops it or sets it going again. A
  // reader who asked the system for less motion keeps the dots, which move
  // slowly along the lines, but loses the rings and the beat (see the CSS);
  // nothing is drawn stroke by stroke for that reader, so the dots leave at once.
  const fig = document.querySelector<HTMLElement>('.convergence');
  const btn = fig?.querySelector<HTMLButtonElement>('.cv-toggle');
  if (fig && btn) {
    const svgs = [...fig.querySelectorAll('svg')];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) svgs.forEach((s) => s.setCurrentTime(3));
    let moving = true;
    btn.addEventListener('click', () => {
      moving = !moving;
      svgs.forEach((s) => (moving ? s.unpauseAnimations() : s.pauseAnimations()));
      btn.textContent = moving ? btn.dataset.pause! : btn.dataset.play!;
    });
    btn.hidden = false;
  }
</script>

---
// The home-page drawing, balanced around the red capital at its centre. On the
// left, the three functions of information arrive, each in its own time, and
// meet in one line (chapter 1 of the thesis). In the middle, in red, the open
// circle of a capital that reproduces itself (chapter 2). On the right, the
// line reaches the heart of three circles that overlap: the economy, the
// biophysical world and the climate (chapter 3). Three into one, one into
// three; the strands reach as far to the left as the circles to the right.
// Red dots leave the strands, turn in the capital and enter the fields. Two
// layouts: wide (left to right) and narrow (top to bottom) for phones.
//
// On a field page the same drawing comes back smaller (mini), with the part
// that field looks at lit and the rest left pale: history, the three functions
// arriving; economics, the capital and the circle of the economy; biophysics,
// the circle of energy; climate, the circle of the climate. There the dots
// tell a story instead of a steady flow (src/scripts/cv-story.ts): one per
// function, then pairs that meet or miss each other, a capital that gathers
// them, the field of the page reached first, and the others in their turn,
// until all three are touched, in about fifteen seconds.
import { langOf, ui } from '../i18n';
type Field = 'history' | 'economics' | 'biophysics' | 'climate';
interface Props { focus?: Field; mini?: boolean }
const { focus, mini = false } = Astro.props;
const t = ui[langOf(Astro.url.pathname)].convergence;
// The circles of the fields in their order: economy, energy, climate.
const circlePart: Field[] = ['economics', 'biophysics', 'climate'];
const words = t.loop.split(' ');
const half = Math.ceil(words.length / 2);
const noteLines = [words.slice(0, half).join(' '), words.slice(half).join(' ')];

type Pt = { x: number; y: number };
const f = (p: Pt) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
const n1 = (v: number) => v.toFixed(1);

// Three overlapping circles around a heart V, and what the heart sends into
// them: rings that spread (diffusion), thin red roots that grow into each
// circle (complexity), and sparks that pass from one circle to the next
// through the zones where they overlap (interaction). Built in units of r, so
// both layouts share it.
function venn(V: Pt, r: number, d: number) {
  const pt = (deg: number, k: number) => ({ x: V.x + k * r * Math.cos((deg * Math.PI) / 180), y: V.y + k * r * Math.sin((deg * Math.PI) / 180) });
  // Economy (upper left), energy (upper right), climate (below).
  const circles = [
    { x: V.x - 0.866 * d, y: V.y - 0.5 * d },
    { x: V.x + 0.866 * d, y: V.y - 0.5 * d },
    { x: V.x, y: V.y + d },
  ];
  const arms = [{ th: 210, a: -16, b: 24 }, { th: 330, a: -22, b: 18 }, { th: 90, a: -22, b: 22 }];
  const roots: { d: string; i: number; lvl: number }[] = [];
  const tips: (Pt & { deg: number; path: string })[] = [];
  arms.forEach((A, i) => {
    const S = pt(A.th + 6, 0.58), c = pt(A.th - 8, 0.3);
    const stem = `M${f(V)}Q${f(c)} ${f(S)}`;
    roots.push({ d: stem, i, lvl: 0 });
    for (const [da, k] of [[A.a, 1.04], [A.b, 1.14]]) {
      const T = pt(A.th + da, k), c2 = pt(A.th + da * 0.4, 0.85);
      roots.push({ d: `M${f(S)}Q${f(c2)} ${f(T)}`, i, lvl: 1 });
      tips.push({ ...T, deg: A.th + da, path: `${stem}Q${f(c2)} ${f(T)}` });
    }
  });
  // Each link leaves one circle's root and reaches the next, through their overlap.
  const links = [[0, 1], [1, 2], [2, 0]].map(([i, j]) => {
    const from = tips[2 * i + 1], to = tips[2 * j];
    let mid = (from.deg + to.deg) / 2;
    if (Math.abs(from.deg - to.deg) > 180) mid += 180;
    return `M${f(from)}Q${f(pt(mid, 1.05))} ${f(to)}`;
  });
  return { V, r, circles, roots, tips, links, R: 1.35 * r, reach: r + 0.866 * d };
}

// The capital: the open circle of the site's mark, its gap at the upper right.
function ring(c: Pt, rc: number) {
  const at = (deg: number) => ({ x: c.x + rc * Math.cos((deg * Math.PI) / 180), y: c.y + rc * Math.sin((deg * Math.PI) / 180) });
  return `M${f(at(-60))}A${rc} ${rc} 0 1 0 ${f(at(-22))}`;
}

// A strand from its first point to the knot K where the three meet, leaving
// and arriving level with the line (horizontal or vertical).
function strand(s: Pt, K: Pt, vertical: boolean) {
  if (vertical ? s.x === K.x : s.y === K.y) return `M${f(s)}L${f(K)}`;
  if (vertical) {
    const span = K.y - s.y;
    return `M${f(s)}C${n1(s.x)} ${n1(s.y + 0.5 * span)} ${n1(K.x)} ${n1(K.y - 0.3 * span)} ${f(K)}`;
  }
  const span = K.x - s.x;
  return `M${f(s)}C${n1(s.x + 0.5 * span)} ${n1(s.y)} ${n1(K.x - 0.3 * span)} ${n1(K.y)} ${f(K)}`;
}

// The flow: six small red dots, one every 1.5 s. Each leaves one of the three
// strands, turns one and a half times in the capital and reaches the heart of
// the fields in 5.5 s whatever its strand, then enters one circle along a root
// in 1.5 s, and starts again 9.5 s later. Strands and circles are crossed, so
// that each function feeds two fields. When a dot reaches a root that touches
// the next circle, a smaller dot carries on along the link, through the zone
// where the two overlap.
const START = 3.2, GAP = 1.5, T1 = 5.5, T2 = 1.5, CYCLE = 9.5;
const dots = [0, 1, 2, 3, 4, 5].map((n) => ({ n, strand: n % 3, tip: (n * 5) % 6 }));
const linkFrom = [1, 3, 5].map((tip) => dots.find((d) => d.tip === tip)!.n);
const labelsOf = [t.transmit, t.compute, t.store];

// Wide layout, viewBox 1160 x 420: the capital at the centre; the first strand
// starts as far to the left as the circles reach to the right.
const W = (() => {
  const Y = 205, X0 = 580, D = 340, r = 100, d = 56, rc = 46;
  const R = venn({ x: X0 + D, y: Y }, r, d);
  const into = { x: X0 - rc, y: Y }, outof = { x: X0 + rc, y: Y };
  const K = { x: into.x - 70, y: Y };
  const x0 = X0 - D - R.reach;
  const starts = [{ x: x0, y: Y - 118 }, { x: x0 + 80, y: Y }, { x: x0 + 160, y: Y + 118 }];
  const [c0, c1, c2] = R.circles;
  return {
    box: '0 0 1160 420', R, cap: { x: X0, y: Y, rc, ain: 180, aout: 0 },
    // The names sit above their first point, the lowest below it, clear of its strand.
    strands: starts.map((s, i) => ({ ...s, d: strand(s, K, false), label: labelsOf[i], anchor: 'start', dy: i === 2 ? (mini ? 34 : 24) : mini ? -20 : -13 })),
    ring: ring({ x: X0, y: Y }, rc),
    trunks: [`M${f(K)}L${f(into)}`, `M${f(outof)}L${f(R.V)}`],
    // From the knot, once and a half round the capital, to the heart of the fields.
    tail: `L${f(into)}A${rc} ${rc} 0 0 1 ${f(outof)}A${rc} ${rc} 0 0 1 ${f(into)}A${rc} ${rc} 0 0 1 ${f(outof)}L${f(R.V)}`,
    note: { x: X0, y: Y + rc + (mini ? 46 : 32), anchor: 'middle', split: false },
    // In the small version the letters are larger: the names of the upper circles sit above them.
    labels: [
      ...(mini
        ? [{ x: c0.x - 40, y: c0.y - r - 14, anchor: 'middle' }, { x: c1.x + 40, y: c1.y - r - 14, anchor: 'middle' }]
        : [{ x: c0.x - 0.72 * r, y: c0.y - 0.72 * r, anchor: 'end' }, { x: c1.x + 0.72 * r, y: c1.y - 0.72 * r, anchor: 'start' }]),
      { x: c2.x, y: c2.y + r + 26, anchor: 'middle' },
    ].map((p, i) => ({ ...p, text: [t.economy, t.energy, t.climate][i] })),
  };
})();

// Narrow layout, viewBox 360 x 680: the functions arrive from above, the
// capital in the middle, the fields below.
const N = (() => {
  const X = 180, Yc = 340, D = 190, r = 76, d = 42, rc = 34;
  const R = venn({ x: X, y: Yc + D }, r, d);
  const into = { x: X, y: Yc - rc }, outof = { x: X, y: Yc + rc };
  const K = { x: X, y: into.y - 50 };
  const starts = [{ x: 60, y: 42 }, { x: X, y: 92 }, { x: 300, y: 142 }];
  const [c0, c1, c2] = R.circles;
  return {
    box: '0 0 360 680', R, cap: { x: X, y: Yc, rc, ain: -90, aout: 90 },
    strands: starts.map((s, i) => ({ ...s, d: strand(s, K, true), label: labelsOf[i], anchor: 'middle', dy: mini ? -16 : -12 })),
    ring: ring({ x: X, y: Yc }, rc),
    trunks: [`M${f(K)}L${f(into)}`, `M${f(outof)}L${f(R.V)}`],
    tail: `L${f(into)}A${rc} ${rc} 0 0 1 ${f(outof)}A${rc} ${rc} 0 0 1 ${f(into)}A${rc} ${rc} 0 0 1 ${f(outof)}L${f(R.V)}`,
    // On a phone the note goes on two lines, left of the capital.
    note: { x: X - rc - 14, y: Yc - 6, anchor: 'end', split: true },
    // The names of the two upper circles sit either side of the line.
    labels: [
      { x: X - 10, y: c0.y - r - 12, anchor: 'end', text: t.economy },
      { x: X + 10, y: c1.y - r - 12, anchor: 'start', text: t.energy },
      { x: c2.x, y: c2.y + r + 24, anchor: 'middle', text: t.climate },
    ],
  };
})();
---
<figure class:list={['convergence', mini && 'cv-mini', focus && `cv-focus cv-focus-${focus}`]}>
  {[{ G: { ...W, id: 'cvw' }, cls: 'cv-wide' }, { G: { ...N, id: 'cvn' }, cls: 'cv-narrow' }].map(({ G, cls }) => (
    <svg class={cls} viewBox={G.box} role="img" aria-label={t.alt} data-cap={`${G.cap.x} ${G.cap.y} ${G.cap.rc} ${G.cap.ain} ${G.cap.aout}`} data-dot={cls === 'cv-wide' ? 4.2 : 3.2}>
      <g class="cv-circles">
        {G.R.circles.map((c, i) => <circle class={`part-${circlePart[i]}`} cx={c.x} cy={c.y} r={G.R.r} />)}
      </g>
      <g class="cv-web" aria-hidden="true">
        <g class="cv-still">{[0.34, 0.62, 0.9].map((k) => <circle class="cv-ring" cx={G.R.V.x} cy={G.R.V.y} r={k * G.R.R} />)}</g>
        {!mini && <g class="cv-waves">{dots.map((p) => (
          <circle class="cv-ring" cx={G.R.V.x} cy={G.R.V.y} r="0" opacity="0">
            <animate attributeName="r" values={`3;${G.R.R}`} dur="5s" begin={`${G.id}p${p.n}a.end`} keySplines="0.2 0.6 0.35 1" calcMode="spline" keyTimes="0;1" fill="freeze" />
            <animate attributeName="opacity" values="0.3;0" dur="5s" begin={`${G.id}p${p.n}a.end`} fill="freeze" />
          </circle>
        ))}</g>}
        {G.R.links.map((d) => <path class="cv-link" d={d} pathLength="1" />)}
        {G.R.roots.map((p) => <path class={`cv-root l${p.lvl} part-${circlePart[p.i]}`} d={p.d} pathLength="1" style={`--i:${p.i}`} />)}
      </g>
      {G.strands.map((s, i) => (
        <g class="cv-strand part-history" style={`--i:${i}`}>
          <path d={s.d} pathLength="1" />
          <circle cx={s.x} cy={s.y} r="3.2" />
          <text x={s.x} y={s.y + s.dy} text-anchor={s.anchor} class="cv-label">{s.label}</text>
        </g>
      ))}
      {G.trunks.map((d, i) => <path class={`cv-trunk t${i}`} d={d} pathLength="1" />)}
      {mini && <circle class="cv-mass" cx={G.cap.x} cy={G.cap.y} r={G.cap.rc * 0.8} />}
      <path class="cv-loop part-economics" d={G.ring} pathLength="1" />
      <text class="cv-note part-economics" x={G.note.x} y={G.note.y} text-anchor={G.note.anchor}>
        {G.note.split ? noteLines.map((line, i) => <tspan x={G.note.x} dy={i === 0 ? 0 : mini ? 26 : 20}>{line}</tspan>) : t.loop}
      </text>
      {mini ? (
        <>
          <g class="cv-guides" fill="none" stroke="none" aria-hidden="true">{G.R.tips.map((p) => <path d={p.path} />)}</g>
          <g class="cv-flow" aria-hidden="true"></g>
        </>
      ) : <g class="cv-flow" aria-hidden="true">
        <circle class="cv-beat" cx={G.R.V.x} cy={G.R.V.y} r="5" opacity="0">
          <animate attributeName="r" values="5;12" dur="0.8s" begin={dots.map((p) => `${G.id}p${p.n}a.end`).join(';')} fill="freeze" />
          <animate attributeName="opacity" values="0.5;0" dur="0.8s" begin={dots.map((p) => `${G.id}p${p.n}a.end`).join(';')} fill="freeze" />
        </circle>
        {dots.map((p) => (
          <circle class="cv-dot" r="2.6" opacity="0">
            <animateMotion id={`${G.id}p${p.n}a`} path={G.strands[p.strand].d + G.tail} dur={`${T1}s`} begin={`${START + GAP * p.n}s;${G.id}p${p.n}b.end+${CYCLE - T1 - T2}s`} fill="freeze" />
            <animateMotion id={`${G.id}p${p.n}b`} path={G.R.tips[p.tip].path} dur={`${T2}s`} begin={`${G.id}p${p.n}a.end`} fill="freeze" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.3 0.5 0.4 1" />
            <animate attributeName="opacity" values="0;0.95" dur="0.4s" begin={`${G.id}p${p.n}a.begin`} fill="freeze" />
            <animate attributeName="opacity" values="0.95;0.95;0" keyTimes="0;0.7;1" dur={`${T2}s`} begin={`${G.id}p${p.n}b.begin`} fill="freeze" />
          </circle>
        ))}
        {G.R.links.map((d, k) => (
          <circle class="cv-dot" r="1.8" opacity="0">
            <animateMotion path={d} dur="2.2s" begin={`${G.id}p${linkFrom[k]}b.end-0.3s`} fill="freeze" />
            <animate attributeName="opacity" values="0;0.8;0.8;0" keyTimes="0;0.15;0.8;1" dur="2.2s" begin={`${G.id}p${linkFrom[k]}b.end-0.3s`} fill="freeze" />
          </circle>
        ))}
      </g>}
      <circle class="cv-heart" cx={G.R.V.x} cy={G.R.V.y} r="5" />
      {G.R.tips.map((p, n) => <circle class={`cv-node part-${circlePart[Math.floor(n / 2)]}`} cx={p.x} cy={p.y} r="2.1" style={`--n:${n}`} />)}
      {G.labels.map((l, i) => <text class={`cv-label cv-field part-${circlePart[i]}`} x={l.x} y={l.y} text-anchor={l.anchor}>{l.text}</text>)}
    </svg>
  ))}
  <button class="cv-toggle" type="button" hidden data-play={t.play} data-pause={t.pause}>{t.pause}</button>
</figure>

<script>
  // The drawing always moves; one click stops it or sets it going again. A
  // reader who asked the system for less motion keeps the dots, which move
  // slowly along the lines, but loses the rings and the beat (see the CSS).
  import '../scripts/cv-story';
  const fig = document.querySelector<HTMLElement>('.convergence');
  const btn = fig?.querySelector<HTMLButtonElement>('.cv-toggle');
  if (fig && btn) {
    const svgs = [...fig.querySelectorAll('svg')];
    let moving = true;
    btn.addEventListener('click', () => {
      moving = !moving;
      svgs.forEach((s) => (moving ? s.unpauseAnimations() : s.pauseAnimations()));
      fig.classList.toggle('cv-paused', !moving);
      btn.textContent = moving ? btn.dataset.pause! : btn.dataset.play!;
    });
    btn.hidden = false;
  }
</script>

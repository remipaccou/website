---
import { site } from '../site';
import { href } from '../lib/url';
import { talks } from '../data/talks';
const nav = site.nav.filter((item) => item.path !== '/talks/' || talks.length > 0);
const here = Astro.url.pathname;
const isCurrent = (path: string) => here.startsWith(href(path));
---
<header class="site-header">
  <div class="wrap">
    <a class="site-name" href={href('/')}><svg class="site-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M33.5 7.6A19 19 0 1 0 41.6 17" /></svg><span>{site.author}</span></a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

---
import { site } from '../site';
import { href } from '../lib/url';
const here = Astro.url.pathname;
const isCurrent = (path: string) => here.startsWith(href(path));
---
<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="site-name" href={href('/')}>{site.author}</a>
    <nav aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li><a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

---
import { href } from '../lib/url';
import { pathOf, longDate, isoDate, type Essay } from '../lib/writing';
import { scriptsToHtml } from '../lib/typography.mjs';
import { langOf, ui } from '../i18n';
import Sigil from './Sigil.astro';
interface Props { essay: Essay; sign?: boolean }
const { essay, sign = true } = Astro.props;
const theme = sign ? essay.data.theme : undefined;
const lang = langOf(Astro.url.pathname);
---
<li class="essay">
  <div class="essay-date"><time datetime={isoDate(essay.data.date)}>{longDate(essay.data.date, lang)}</time>{theme && <Sigil name={theme} class="item-sign" />}</div>
  <div class="essay-body">
    <h3 class="essay-title"><a href={href(pathOf(essay))} lang="en">{essay.data.title}</a></h3>
    {lang === 'fr' && essay.data.descriptionFr
      ? <p class="essay-desc" set:html={scriptsToHtml(essay.data.descriptionFr)} />
      : <p class="essay-desc" lang="en" set:html={scriptsToHtml(essay.data.description)} />}
    {ui[lang].inEnglish && <p class="essay-note">{ui[lang].inEnglish}</p>}
  </div>
</li>

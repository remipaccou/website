---
import Sigil from './Sigil.astro';
interface Props { title: string; sigil?: 'history' | 'economics' | 'biophysics' | 'climate' }
const { title, sigil } = Astro.props;
---
<header class="page-head band">
  <div class="band-label page-sigil">{sigil && <Sigil name={sigil} />}</div>
  <div class="band-main">
    <h1 class="page-title">{title}</h1>
  </div>
</header>

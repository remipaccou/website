---
import Sigil from './Sigil.astro';
import { site } from '../site';
import { href } from '../lib/url';
import { langOf, ui } from '../i18n';
const t = ui[langOf(Astro.url.pathname)];
const { email, github, linkedin, orcid, scholar } = site.links;
const links = [
  email && { label: 'Email', url: `mailto:${email}` },
  linkedin && { label: 'LinkedIn', url: linkedin },
  orcid && { label: 'ORCID', url: orcid },
  scholar && { label: 'Google Scholar', url: scholar },
  github && { label: 'GitHub', url: github },
  { label: t.rss, url: href('/rss.xml') },
].filter(Boolean) as { label: string; url: string }[];
---
<footer class="site-footer">
  <Sigil name="enso" class="footer-mark" />
  <div class="wrap site-footer-inner">
    <p>© {new Date().getFullYear()} {site.author}. {t.views} <span class="page-weight" hidden data-label={t.weight}></span></p>
    <ul>
      {links.map((l) => <li><a href={l.url} target={/^https?:/.test(l.url) ? '_blank' : undefined} rel="noopener">{l.label}</a></li>)}
    </ul>
  </div>
</footer>

<script>
  // What this page weighs: the bytes the server sent for it, as the browser
  // counts them (the page, its styles, scripts, fonts and images), updated as
  // late images arrive. A weight, not an estimate of energy.
  const out = document.querySelector<HTMLElement>('.page-weight');
  if (out && 'performance' in window) {
    const lang = document.documentElement.lang;
    const total = () => {
      const entries = [...performance.getEntriesByType('navigation'), ...performance.getEntriesByType('resource')] as PerformanceResourceTiming[];
      return entries.reduce((sum, e) => sum + (e.encodedBodySize || e.transferSize || 0), 0);
    };
    const show = () => {
      const kb = Math.max(1, Math.round(total() / 1000));
      out.textContent = (out.dataset.label ?? '').replace('{n}', kb.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-GB'));
      out.hidden = false;
    };
    addEventListener('load', () => {
      show();
      try { new PerformanceObserver(show).observe({ type: 'resource', buffered: false }); } catch {}
    });
  }
</script>

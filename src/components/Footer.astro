---
import Sigil from './Sigil.astro';
import { site } from '../site';
import { href } from '../lib/url';
import { langOf, ui } from '../i18n';
const t = ui[langOf(Astro.url.pathname)];
const { email, github, linkedin, orcid, scholar } = site.links;
const links = [
  email && { label: 'Email', url: `mailto:${email}` },
  linkedin && { label: 'LinkedIn', url: linkedin },
  orcid && { label: 'ORCID', url: orcid },
  scholar && { label: 'Google Scholar', url: scholar },
  github && { label: 'GitHub', url: github },
  { label: t.rss, url: href('/rss.xml') },
].filter(Boolean) as { label: string; url: string }[];
---
<footer class="site-footer">
  <Sigil name="enso" class="footer-mark" />
  <div class="wrap site-footer-inner">
    <p>© {new Date().getFullYear()} {site.author}. {t.views}</p>
    <ul>
      {links.map((l) => <li><a href={l.url} target={/^https?:/.test(l.url) ? '_blank' : undefined} rel="noopener">{l.label}</a></li>)}
    </ul>
  </div>
</footer>

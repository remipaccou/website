---
// Temporary: lets the three home page drafts be compared. Remove with /a/, /b/ and /c/.
import { href } from '../lib/url';
interface Props { current: string }
const { current } = Astro.props;
const drafts = [
  { id: 'a', name: 'Revue' },
  { id: 'b', name: 'Planche' },
  { id: 'c', name: 'Bandes' },
  { id: 'd', name: 'Ma' },
  { id: 'e', name: 'Soleil' },
  { id: 'f', name: 'Index' },
];
---
<nav class="drafts" aria-label="Home page drafts">
  <span>Home page drafts</span>
  {drafts.map((d) => (
    <a href={href(`/${d.id}/`)} aria-current={d.id === current ? 'page' : undefined}>{d.id.toUpperCase()}<i> {d.name}</i></a>
  ))}
</nav>

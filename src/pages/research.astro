---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';

// Each theme is a short paragraph. Edit the text freely.
const themes = [
  {
    title: 'Electricity demand from data centres and AI',
    text: 'System dynamics models of how data centre capacity, hardware efficiency and AI workloads translate into electricity demand, applied to Texas (ERCOT), Northern Virginia and Europe. The purpose is to make explicit the assumptions that sit behind demand forecasts, and to show how far the results move when those assumptions change.',
  },
  {
    title: 'Digitalisation in energy and climate scenarios',
    text: 'How integrated assessment models can represent digitalisation and AI, both as an energy demand of their own and as a force that changes demand in buildings, transport and industry. This is the subject of my doctoral work with the IMACLIM-R model, and of a multi-model assessment led by Charlie Wilson to which I contribute.',
  },
  {
    title: 'Physical limits of computing',
    text: "What thermodynamics allows: Landauer's bound on the energy cost of computation, the capacity of the Earth to dissipate heat, and the distance that separates present hardware from those limits.",
  },
  {
    title: 'Net impacts of digital technologies',
    text: 'Whether a digital solution avoids more energy use and emissions than it causes depends on where and how it is deployed. I work on methods to assess this balance, with AI-controlled microgrids as a case.',
  },
  {
    title: 'History of information systems',
    text: 'Earlier information infrastructures, and the ideas that accompanied them, read for what they tell us about present debates on AI and its energy use.',
  },
];
---
<Base title="Research" description="Research themes of Rémi Paccou: electricity demand from data centres and AI, digitalisation in energy and climate scenarios, physical limits of computing.">
  <div class="wrap">
    <header class="page-head band">
      <div class="band-label" aria-hidden="true"></div>
      <div class="band-main">
        <h1 class="page-title">Research</h1>
        <p class="page-lead">
          Information technologies are often absent from the models used to explore energy and climate futures, or
          present only as a line of electricity demand. I try to describe what they change in the structure of the
          economy, how computing and energy are coupled, and what the history of earlier information systems suggests
          about the present one.
        </p>
      </div>
    </header>

    <section class="band">
      <h2 class="band-label">Themes</h2>
      <div class="band-main prose">
        {themes.map((theme) => (
          <>
            <h3>{theme.title}</h3>
            <p>{theme.text}</p>
          </>
        ))}
      </div>
    </section>

    <section class="band">
      <h2 class="band-label">Doctorate</h2>
      <div class="band-main prose">
        <p>
          I am preparing a doctorate at CIRED, the Centre International de Recherche sur l'Environnement et le
          Développement, under the supervision of Franck Lecocq. The thesis examines digitalisation in energy and
          climate scenarios: structural change in the economy, the coupling between computing and energy, and the
          lessons of history.
        </p>
        <p>The results appear in the <a href={href('/publications/')}>publications</a>; the <a href={href('/writing/')}>essays</a> are a place for ideas that do not yet fit in a paper.</p>
      </div>
    </section>
  </div>
</Base>

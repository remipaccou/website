---
import Base from '../../layouts/Base.astro';
import EssayItem from '../../components/EssayItem.astro';
import { getEssays } from '../../lib/writing';
const essays = await getEssays();
---
<Base title="Essays" description="Essays by Rémi Paccou on information, energy and ecology.">
  <div class="wrap">
    <header class="page-head band">
      <div class="band-label" aria-hidden="true"></div>
      <div class="band-main">
        <h1 class="page-title">Essays</h1>
      </div>
    </header>
    <ul class="list">
      {essays.map((essay) => <EssayItem essay={essay} />)}
    </ul>
  </div>
</Base>

---
// Home page, built as a register:
//   0. triad    the three words of the title under their Greek roots
//   1. lead     the latest essay, text first, its image beside it
//   2. notices  dated register of everything new, with a narrow side column
//   4. footer   (in the layout)
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../site';
import { href } from '../lib/url';
import { getEssays, pathOf, longDate, isoDate } from '../lib/writing';
import { scriptsToHtml } from '../lib/typography.mjs';
import { publications } from '../lib/publications';
import { getNotices } from '../lib/notices';
import { talks } from '../data/talks';

const essays = await getEssays();
const lead = essays[0];
// The three words of the title, each under the Greek word it comes from.
const triad = [
  { greek: 'μορφή', word: 'Information' },
  { greek: 'ἐνέργεια', word: 'Energy' },
  { greek: 'οἶκος', word: 'Ecology' },
];
const notices = await getNotices();
---
<Base>
  <div class="wrap home">
    <h1 class="triad">
      {triad.map((t) => (
        <span><i lang="grc">{t.greek}</i><b>{t.word}</b></span>
      ))}
    </h1>

    {lead && (
      <article class="lead">
        <div class="lead-text">
          <p class="meta"><time datetime={isoDate(lead.data.date)}>{longDate(lead.data.date)}</time></p>
          <h2 class="lead-title"><a href={href(pathOf(lead))}>{lead.data.title}</a></h2>
          <p class="lead-desc" set:html={scriptsToHtml(lead.data.description)} />
          <p class="more"><a href={href(pathOf(lead))}>Read the essay</a></p>
        </div>
        {lead.data.cover && (
          <a class="lead-image" href={href(pathOf(lead))} tabindex="-1" aria-hidden="true">
            <Image src={lead.data.cover} alt="" widths={[480, 800, 1200]} sizes="(max-width: 54rem) 100vw, 26rem" loading="eager" />
          </a>
        )}
      </article>
    )}

    <section class="block">
      <SectionHead title="Notices" />
      <div class="with-side">
        <ul class="notices">
          {notices.map((n) => (
            <li>
              <span class="meta">{n.label}</span>
              <span class="meta">{n.kind}</span>
              <p>
                {n.url ? <a href={n.url}>{n.text}</a> : n.text}
                {n.detail && <cite>{n.detail}</cite>}
              </p>
            </li>
          ))}
        </ul>
        <aside class="side">
          <h3 class="side-head">About</h3>
          <p>{site.about}</p>
          <p><a href={href('/about/')}>More</a></p>
          <h3 class="side-head">Sections</h3>
          <ul>
            <li><a href={href('/writing/')}>Essays</a> <span>{essays.length}</span></li>
            <li><a href={href('/publications/')}>Papers</a> <span>{publications.length}</span></li>
            {talks.length > 0 && <li><a href={href('/talks/')}>Talks</a> <span>{talks.length}</span></li>}
          </ul>
          <h3 class="side-head">Follow</h3>
          <ul>
            <li><a href={href('/rss.xml')}>RSS feed</a></li>
          </ul>
        </aside>
      </div>
    </section>
  </div>
</Base>

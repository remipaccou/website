---
import Base from '../layouts/Base.astro';
import { site } from '../site';
const { email, github, linkedin, orcid, scholar } = site.links;
const contacts = [
  email && { label: 'Email', url: `mailto:${email}` },
  linkedin && { label: 'LinkedIn', url: linkedin },
  orcid && { label: 'ORCID', url: orcid },
  scholar && { label: 'Google Scholar', url: scholar },
  github && { label: 'GitHub', url: github },
].filter(Boolean) as { label: string; url: string }[];
---
<Base title="About" description="About Rémi Paccou.">
  <div class="wrap">
    <header class="page-head band">
      <div class="band-label" aria-hidden="true"></div>
      <div class="band-main">
        <h1 class="page-title">About</h1>
      </div>
    </header>

    <section class="band">
      <div class="band-label" aria-hidden="true"></div>
      <div class="band-main prose">
        <p>
          I am Rémi Paccou. I work on what information technologies do to energy systems and to the climate, as a
          doctoral researcher at CIRED and at Schneider Electric's research institute.
        </p>
        <p>I trained as an engineer in thermodynamics at Arts et Métiers.</p>
        <p>
          The views expressed here are my own.
          {contacts.length > 0 && <>You can reach me through {contacts.map((c, i) => <>{i > 0 && (i === contacts.length - 1 ? ' or ' : ', ')}<a href={c.url}>{c.label}</a></>)}.</>}
        </p>
      </div>
    </section>
  </div>
</Base>

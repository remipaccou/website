---
import 'katex/dist/katex.min.css';
import 'computer-modern/cmu-serif.css';
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../../../../layouts/Base.astro';
import Sigil from '../../../../components/Sigil.astro';
import Frise from '../../../../components/Frise.astro';
import { site } from '../../../../site';
import { scriptsToHtml } from '../../../../lib/typography.mjs';
import { getEssays, dateParts, slugOf, longDate, isoDate, pathOf } from '../../../../lib/writing';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay) => ({
    params: { ...dateParts(essay.data.date), slug: slugOf(essay) },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const { title, description, date, topic, cover, coverAlt, theme, revisions, frise } = essay.data;

// How to cite the essay: BibTeX and APA, built here so that they match the page.
// The lasting address: the domain, whatever host serves this build (the path is the same).
const url = `https://remipaccou.blog${pathOf(essay)}`;
const year = date.getUTCFullYear();
const key = `paccou${year}${(title.match(/[A-Za-z]{4,}/g) ?? ['essay']).find((w) => !/^(the|from|with|what|when|where|that|this)$/i.test(w))!.toLowerCase()}`;
const bibtex = `@misc{${key},
  author       = {Paccou, R{\\'e}mi},
  title        = {{${title}}},
  year         = {${year}},
  month        = ${date.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).toLowerCase()},
  howpublished = {\\url{${url}}},
  note         = {Essay}
}`;
const apa = `Paccou, R. (${year}, ${date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}). ${title} [Essay]. Rémi Paccou. ${url}`;
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---
<Base title={title} description={description} image={shareImage} type="article" published={date}>
  <!-- Essays are set like a LaTeX article: Computer Modern throughout,
       numbered sections, equations, figures and tables. -->
  <div class="read-brush" aria-hidden="true"><span class="read-line"></span><Sigil name="enso" class="read-mark" /></div>
  <article class="wrap paper">
    <header class="paper-head">
      <h1>{title}</h1>
      <p class="paper-author">{site.author}</p>
      <p class="paper-date"><time datetime={isoDate(date)}>{longDate(date)}</time></p>
      {theme && <Sigil name={theme} class="paper-seal" />}
    </header>

    <section class="paper-abstract">
      <h2>Abstract</h2>
      <p set:html={scriptsToHtml(description)} />
    </section>

    {cover && (
      <figure class="paper-cover">
        <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(max-width: 40rem) 100vw, 24rem" loading="eager" />
      </figure>
    )}

    <div class="prose paper-body">
      <Content />
      {frise && (
        <Fragment>
          <Frise id={frise} paper />
          {/* Into its place in the text, before the page is drawn; without scripts it stays here. */}
          <script is:inline>
            (() => {
              const s = document.currentScript, f = s.previousElementSibling;
              const slot = f && document.querySelector('.frise-slot[data-frise="' + f.dataset.id + '"]');
              if (slot) slot.replaceWith(f);
              s.remove();
            })();
          </script>
        </Fragment>
      )}
    </div>
    {revisions.length > 0 && (
      <section class="paper-revisions">
        <h2>Revisions</h2>
        {revisions.map((r) => <p><time datetime={isoDate(r.date)}>{longDate(r.date)}</time>. {r.note}</p>)}
      </section>
    )}
    <details class="paper-cite">
      <summary>Cite this essay</summary>
      <p class="cite-apa">{apa}</p>
      <pre class="cite-bib">{bibtex}</pre>
      <p class="cite-copy"><button type="button" data-copy={apa}>Copy APA</button><button type="button" data-copy={bibtex}>Copy BibTeX</button><span class="cite-done" aria-live="polite"></span></p>
    </details>
    <Sigil name="enso" class="paper-end" />
  </article>
  <script>import '../../../../scripts/paper';</script>
  <script is:inline>addEventListener('beforeprint', () => document.querySelectorAll('details.fold').forEach((d) => (d.open = true)));</script>
  <script>import '../../../../scripts/frises';</script>
</Base>

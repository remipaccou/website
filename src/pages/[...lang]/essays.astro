---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EssayItem from '../../components/EssayItem.astro';
import { getEssays } from '../../lib/writing';
import { langOf, langPaths, ui } from '../../i18n';
export const getStaticPaths = langPaths;
const t = ui[langOf(Astro.url.pathname)];
const essays = await getEssays();
---
<Base title={t.essays}>
  <div class="wrap">
    <PageHead title={t.essays} />
    <ul class="list">
      {essays.map((essay) => <EssayItem essay={essay} />)}
    </ul>
  </div>
</Base>

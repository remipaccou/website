---
// One page per field: everything filed under it, whatever its kind.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EssayItem from '../../components/EssayItem.astro';
import Publication from '../../components/Publication.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { getEssays } from '../../lib/writing';
import { publications } from '../../lib/publications';
import { projects } from '../../data/projects';
import { books } from '../../data/books';
import { langOf, lp, themes, ui } from '../../i18n';

export function getStaticPaths() {
  return themes.flatMap((th) => [{ params: { lang: undefined, theme: th.id } }, { params: { lang: 'fr', theme: th.id } }]);
}
const lang = langOf(Astro.url.pathname);
const t = ui[lang];
const th = themes.find((x) => x.id === Astro.params.theme)!;
const essays = (await getEssays()).filter((e) => e.data.theme === th.id);
const articles = publications.filter((p) => p.theme === th.id);
const mine = projects.filter((p) => p.theme === th.id);
const myBooks = books.filter((p) => p.theme === th.id);
const empty = essays.length + articles.length + mine.length + myBooks.length === 0;
---
<Base title={th[lang]}>
  <div class="wrap">
    <PageHead title={th[lang]} sigil={th.id} />
    {empty && (
      <section class="band">
        <div class="band-label" aria-hidden="true"></div>
        <div class="band-main"><p>{t.none}</p></div>
      </section>
    )}
    {essays.length > 0 && (
      <section class="band">
        <h2 class="band-label">{t.essays}</h2>
        <div class="band-main"><ul class="list">{essays.map((essay) => <EssayItem essay={essay} />)}</ul></div>
      </section>
    )}
    {articles.length > 0 && (
      <section class="band">
        <h2 class="band-label">{t.articles}</h2>
        <div class="band-main"><ul class="list">{articles.map((item) => <Publication item={item} />)}</ul></div>
      </section>
    )}
    {mine.length > 0 && (
      <section class="band">
        <h2 class="band-label">{t.projects}</h2>
        <div class="band-main"><ul class="list">{mine.map((item) => <ProjectItem item={item} compact />)}</ul></div>
      </section>
    )}
    {myBooks.length > 0 && (
      <section class="band">
        <h2 class="band-label">{t.books}</h2>
        <div class="band-main"><ul class="list">{myBooks.map((b) => (
          <li class="pub">
            <span class="pub-year">{b.status[lang]}</span>
            <div class="pub-body">
              <p class="pub-title"><a href={lp(lang, '/books/')}>{b.title[lang]}</a></p>
              <p class="pub-meta">{b.subtitle[lang]}</p>
            </div>
          </li>
        ))}</ul></div>
      </section>
    )}
  </div>
</Base>

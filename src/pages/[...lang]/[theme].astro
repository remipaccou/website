---
// One page per field: everything filed under it, whatever its kind.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EssayItem from '../../components/EssayItem.astro';
import Convergence from '../../components/Convergence.astro';
import HistorySwirl from '../../components/HistorySwirl.astro';
import Frise from '../../components/Frise.astro';
import Publication from '../../components/Publication.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { getEssays } from '../../lib/writing';
import { publications } from '../../lib/publications';
import { projects } from '../../data/projects';
import { books } from '../../data/books';
import { langOf, lp, themes, ui } from '../../i18n';

export function getStaticPaths() {
  return themes.flatMap((th) => [{ params: { lang: undefined, theme: th.id } }, { params: { lang: 'fr', theme: th.id } }]);
}
const lang = langOf(Astro.url.pathname);
const t = ui[lang];
const th = themes.find((x) => x.id === Astro.params.theme)!;
const historyCaption = projects.find((p) => p.theme === 'history' && p.figure)?.figure?.caption?.[lang];
const essays = (await getEssays()).filter((e) => e.data.theme === th.id);
const articles = publications.filter((p) => p.theme === th.id);
const mine = projects.filter((p) => p.theme === th.id);
const myBooks = books.filter((p) => p.theme === th.id);
const empty = essays.length + articles.length + mine.length + myBooks.length === 0;
---
<Base title={th[lang]}>
  <div class="wrap">
    <PageHead title={th[lang]} sigil={th.id} line={th.line[lang]} by={th.by[lang]} quoteLang={'quoteLang' in th ? th.quoteLang : undefined} />
    {/* History has its own drawing, the thread that winds in towards today; the other fields
        bring back the home-page drawing, smaller, with the part they look at lit; philosophy
        looks at the whole, all of it lit. */}
    <section class="band cv-band">
      <div class="band-label" aria-hidden="true"></div>
      <div class="band-main">{th.id === 'history' ? <HistorySwirl /> : th.id === 'philosophy' ? <Convergence mini /> : <Convergence focus={th.id} mini />}</div>
    </section>
    {/* The thesis timelines: under the threads on the history page, the map of the three functions
        (its year tied to the threads) and the one of transmitting; on the economics page, the
        confluence of the techniques into one stock of capital. */}
    {th.id === 'history' && (
      <section class="frise-band">
        <Frise id="tree" sync caption={historyCaption} />
        <Frise id="transmit" hint={t.swirl.friseSolo} />
      </section>
    )}
    {th.id === 'economics' && (
      <section class="frise-band">
        <Frise id="confluence" hint={t.swirl.friseSolo} />
      </section>
    )}
    <script>import '../../scripts/history';</script>
    <script>import '../../scripts/frises';</script>
    {empty && (
      <section class="band">
        <div class="band-label" aria-hidden="true"></div>
        <div class="band-main"><p>{t.none}</p></div>
      </section>
    )}
    {essays.length > 0 && (
      <section class="band">
        <h2 class="band-label">{t.essays}</h2>
        <div class="band-main"><ul class="list">{essays.map((essay) => <EssayItem essay={essay} sign={false} />)}</ul></div>
      </section>
    )}
    {articles.length > 0 && (
      <section class="band">
        <h2 class="band-label">{t.articles}</h2>
        <div class="band-main"><ul class="list">{articles.map((item) => <Publication item={item} sign={false} />)}</ul></div>
      </section>
    )}
    {mine.length > 0 && (
      <section class="band">
        <h2 class="band-label">{t.projects}</h2>
        <div class="band-main"><ul class="list">{mine.map((item) => <ProjectItem item={item} compact />)}</ul></div>
      </section>
    )}
    {myBooks.length > 0 && (
      <section class="band">
        <h2 class="band-label">{t.books}</h2>
        <div class="band-main"><ul class="list">{myBooks.map((b) => (
          <li class="pub">
            <span class="pub-year"></span>
            <div class="pub-body">
              <p class="pub-title"><a href={lp(lang, '/book/')}>{b.title[lang]}</a></p>
              <p class="pub-meta">{b.subtitle[lang]}. {b.status[lang]}.</p>
            </div>
          </li>
        ))}</ul></div>
      </section>
    )}
  </div>
</Base>

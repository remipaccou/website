---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import BookCover from '../../components/BookCover.astro';
import { books } from '../../data/books';
import { langOf, langPaths, themes, ui } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.url.pathname);
const t = ui[lang];
---
<Base title={t.books}>
  <div class="wrap">
    <PageHead title={t.books} />
    {books.length === 0 && (
      <section class="band">
        <div class="band-label" aria-hidden="true"></div>
        <div class="band-main"><p>{t.none}</p></div>
      </section>
    )}
    {books.map((book) => (
      <section class="book band">
        <p class="band-label book-label">
          <span>{themes.find((th) => th.id === book.theme)?.[lang]}</span>
          <span>{book.status[lang]}</span>
        </p>
        <div class="band-main book-main">
          <BookCover book={book} />
          <div class="book-text">
            <h2 class="book-title">{book.url ? <a href={book.url}>{book.title[lang]}</a> : book.title[lang]}</h2>
            <p class="book-subtitle">{book.subtitle[lang]}</p>
            {book.text && <p class="book-desc">{book.text[lang]}</p>}
          </div>
        </div>
      </section>
    ))}
  </div>
</Base>

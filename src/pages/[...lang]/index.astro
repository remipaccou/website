---
// Home page, built as a register:
//   0. title    the heading, its hairline, the four fields in Greek
//   1. figure   the timelines of the research project, a drawing of the work itself
//   2. lead     the latest essay, in words only
//   3. notices  dated register of everything new, with a narrow side column
//   4. footer   (in the layout)
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Sigil from '../../components/Sigil.astro';
import { href } from '../../lib/url';
import { getEssays, pathOf, longDate, isoDate } from '../../lib/writing';
import { scriptsToHtml } from '../../lib/typography.mjs';
import { publications } from '../../lib/publications';
import { getNotices } from '../../lib/notices';
import { projects } from '../../data/projects';
import { books } from '../../data/books';
import { langOf, langPaths, lp, themes, ui } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.url.pathname);
const t = ui[lang];

const essays = await getEssays();
const lead = essays[0];
const count = (id: string) =>
  essays.filter((e) => e.data.theme === id).length + publications.filter((p) => p.theme === id).length + projects.filter((p) => p.theme === id).length + books.filter((p) => p.theme === id).length;
const notices = await getNotices(lang);
// The first research project with a drawing gives the home page its image.
const drawn = projects.find((p) => p.figure);
const drawing = drawn?.figure && (typeof drawn.figure.src === 'string' ? drawn.figure.src : drawn.figure.src[lang]);
---
<Base>
  <div class="wrap home">
    <h1 class="hero-title">{t.heading}</h1>
    {/* A hairline under the title, closing in the open circle. */}
    <p class="hero-sub">
      <span class="hero-line" aria-hidden="true"></span>
      <Sigil name="enso" class="hero-mark" />
    </p>
    {/* The four fields under their Greek names: down the left edge on wide screens, in a row otherwise. */}
    <p class="greek">
      {themes.map((th) => <a href={lp(lang, `/${th.id}/`)} lang="grc" title={th[lang]}>{th.greek}</a>)}
    </p>

    {drawn && drawing && (
      <figure class="home-figure">
        <a href={lp(lang, '/projects/')}><img src={href(drawing)} alt={drawn.figure!.alt[lang]} /></a>
        <figcaption><a href={lp(lang, '/projects/')}>{drawn.title[lang]}</a><span>{t.projectKind}</span></figcaption>
      </figure>
    )}

    {lead && (
      <article class="lead">
        <div class="lead-text">
          <p class="meta"><time datetime={isoDate(lead.data.date)}>{longDate(lead.data.date, lang)}</time></p>
          <h2 class="lead-title"><a href={href(pathOf(lead))} lang="en">{lead.data.title}</a></h2>
          <p class="lead-desc" lang="en" set:html={scriptsToHtml(lead.data.description)} />
          <p class="more"><a href={href(pathOf(lead))}>{t.readEssay}</a></p>
        </div>
      </article>
    )}

    <section class="block">
      <SectionHead title={t.notices} />
      <div class="with-side">
        <ul class="notices">
          {notices.map((n) => (
            <li>
              <span class="meta">{n.label}</span>
              <span class="meta">{n.kind}</span>
              <p>
                {n.url ? <a href={n.url} target={/^https?:/.test(n.url) ? '_blank' : undefined} rel="noopener">{n.text}</a> : n.text}
                {n.detail && <cite>{n.detail}</cite>}
              </p>
            </li>
          ))}
        </ul>
        <aside class="side">
          <h3 class="side-head">{t.about}</h3>
          <p>{t.aboutLine}</p>
          <p><a href={lp(lang, '/about/')}>{t.more}</a></p>
          <h3 class="side-head">{t.themes}</h3>
          <ul>
            {themes.map((th) => <li class="with-sigil"><Sigil name={th.id} /><a href={lp(lang, `/${th.id}/`)}>{th[lang]}</a> <span>{count(th.id)}</span></li>)}
          </ul>
        </aside>
      </div>
    </section>
  </div>
</Base>

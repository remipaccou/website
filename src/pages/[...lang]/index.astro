---
// Home page, built as a register:
//   0. title    the heading, its hairline, the four fields in Greek
//   1. drawing  the three functions converge into one capital that feeds itself, in the heart of three circles
//      lead-in  two sentences on what the site is about
//   2. lead     the latest essay, in words only
//   3. notices  dated register of everything new
//   4. footer   (in the layout)
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Sigil from '../../components/Sigil.astro';
import Convergence from '../../components/Convergence.astro';
import { href } from '../../lib/url';
import { getEssays, pathOf, longDate, isoDate } from '../../lib/writing';
import { scriptsToHtml } from '../../lib/typography.mjs';
import { getNotices } from '../../lib/notices';
import { langOf, langPaths, lp, themes, ui } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.url.pathname);
const t = ui[lang];

const essays = await getEssays();
const lead = essays[0];
const notices = await getNotices(lang);
---
<Base>
  <div class="wrap home">
    <h1 class="hero-title">{t.heading}</h1>
    {/* A hairline under the title, closing in the open circle. */}
    <p class="hero-sub">
      <span class="hero-line" aria-hidden="true"></span>
      <Sigil name="enso" class="hero-mark" />
    </p>
    {/* The four fields under their Greek names: down the left edge on wide screens, in a row otherwise. */}
    <p class="greek">
      {themes.map((th) => <a href={lp(lang, `/${th.id}/`)} lang="grc" title={th[lang]}>{th.greek}</a>)}
    </p>

    <Convergence />
    <p class="hero-lead">{t.homeLead}</p>

    {lead && (
      <article class="lead">
        <div class="lead-text">
          <p class="meta"><time datetime={isoDate(lead.data.date)}>{longDate(lead.data.date, lang)}</time></p>
          <h2 class="lead-title"><a href={href(pathOf(lead))} lang="en">{lead.data.title}</a></h2>
          <p class="lead-desc" lang="en" set:html={scriptsToHtml(lead.data.description)} />
          <p class="more"><a href={href(pathOf(lead))}>{t.readEssay}</a></p>
        </div>
      </article>
    )}

    <section class="block">
      <SectionHead title={t.notices} />
      <ul class="notices">
          {notices.map((n) => (
            <li>
              <span class="meta notice-year">{n.label}{n.theme && <Sigil name={n.theme as any} class="item-sign" />}</span>
              <span class="meta">{n.kind}</span>
              <p>
                {n.url ? <a href={n.url} target={/^https?:/.test(n.url) ? '_blank' : undefined} rel="noopener">{n.text}</a> : n.text}
                {n.detail && <cite>{n.detail}</cite>}
              </p>
            </li>
          ))}
      </ul>
    </section>
  </div>
</Base>

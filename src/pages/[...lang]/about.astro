---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.png';
import PageHead from '../../components/PageHead.astro';
import { site } from '../../site';
import { langOf, langPaths, ui } from '../../i18n';
export const getStaticPaths = langPaths;
const t = ui[langOf(Astro.url.pathname)];
const { email, github, linkedin, orcid, scholar } = site.links;
const contacts = [
  email && { label: 'Email', url: `mailto:${email}` },
  linkedin && { label: 'LinkedIn', url: linkedin },
  orcid && { label: 'ORCID', url: orcid },
  scholar && { label: 'Google Scholar', url: scholar },
  github && { label: 'GitHub', url: github },
].filter(Boolean) as { label: string; url: string }[];
---
<Base title={t.about}>
  <div class="wrap">
    <PageHead title={t.about} />
    <section class="band about">
      <div class="band-label">
        <Image class="portrait" src={portrait} alt={t.portraitAlt} widths={[240, 480, 720]} sizes="(max-width: 54rem) 60vw, 11rem" loading="eager" />
      </div>
      <div class="band-main prose">
        {t.aboutText.map((para) => <p>{para}</p>)}
        <p>
          {t.views}
          {contacts.length > 0 && <>{' '}{t.reach}{contacts.map((c, i) => <>{i > 0 && (i === contacts.length - 1 ? t.or : ', ')}<a href={c.url}>{c.label}</a></>)}.</>}
        </p>
      </div>
    </section>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import BookItem from '../../components/BookItem.astro';
import { books } from '../../data/books';
import { projects } from '../../data/projects';
import { langOf, langPaths, ui } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.url.pathname);
const t = ui[lang];
---
<Base title={t.projects}>
  <div class="wrap">
    <PageHead title={t.projects} />
    {projects.length + books.length === 0 && (
      <section class="band">
        <div class="band-label" aria-hidden="true"></div>
        <div class="band-main"><p>{t.none}</p></div>
      </section>
    )}
    {projects.length > 0 && (
      <section class="project-group">
        <h2 class="meta">{t.research}</h2>
        <ul class="list">{projects.map((item) => <ProjectItem item={item} />)}</ul>
      </section>
    )}
    {books.length > 0 && (
      <section class="project-group" id="books">
        <h2 class="meta">{t.books}</h2>
        {books.map((book) => <BookItem book={book} />)}
      </section>
    )}
  </div>
</Base>
